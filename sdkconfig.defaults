# ESP32-C3 DevKit: communication and logging go through the built-in USB Serial/JTAG
# (the board has no separate USB-UART bridge), so the console is USB Serial/JTAG.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The chip has 4 MB of built-in flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# The default "single factory app" partition (1 MB) is too small once the
# Bluedroid BLE stack is linked in, so use the custom table (1.9 MB factory).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ---------------------------------------------------------------------------
# Bluetooth Low Energy (BLE central / GATT client) for GoPro control.
# The ESP32 acts as a BLE central and connects to the GoPro GP-Control service.
# ---------------------------------------------------------------------------
CONFIG_BT_ENABLED=y

# Use the Bluedroid host stack (default). The NimBLE stack is an alternative.
CONFIG_BT_BLUEDROID_ENABLED=y

# We only need BLE; disable the Classic BT part to save flash and RAM.
CONFIG_BT_CLASSIC_ENABLED=n

# Enable the BLE GATT client role (we connect out to the camera).
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTC_ENABLE=y

# The GoPro uses legacy (BLE 4.2) advertisement/scanning APIs, so we need the
# BLE 4.2 feature set. The default enables only BLE 5.0 features, which makes
# esp_ble_gap_set_scan_params / esp_ble_gap_start_scanning / esp_ble_gattc_open
# unavailable at link time.
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# The GoPro camera exposes GATT notifications we subscribe to.
CONFIG_BT_GATTS_ENABLE=y

# Bonding / pairing (the GoPro requires an encrypted link).
CONFIG_BT_BLE_SMP_ENABLE=y
