{
    "version": 4,
    "configurations": [
        {
            "name": "ESP-IDF (ESP32-C3)",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "compilerPath": "${env:HOME}/.espressif/tools/riscv32-esp-elf/esp-13.2.0_20240530/riscv32-esp-elf/bin/riscv32-esp-elf-gcc",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64",
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "${env:HOME}/esp/v5.3.1/esp-idf/components"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ]
}
